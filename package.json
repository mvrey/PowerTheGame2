{
  "name": "power-the-game",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:konquest": "vite --open /konquest.html",
    "build": "tsc --noEmit && vite build && vite build --config vite.konquest.config.ts && vite build --config vite.viewer.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "jam": "vite-node src/jam/cli.ts --",
    "dev:viewer": "vite --config vite.viewer.config.ts",
    "research": "vite-node tools/research.ts --"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^5.4.0",
    "vite-plugin-singlefile": "^2.0.2",
    "vitest": "^2.1.0"
  }
}
